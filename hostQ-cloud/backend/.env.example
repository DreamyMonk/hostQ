# hostQ-cloud API config. Copy to .env and fill in.
HOSTQ_ADDR=127.0.0.1:8091
HOSTQ_DB_URL=postgres://hostq:hostq@127.0.0.1:5432/hostq_cloud?sslmode=disable
HOSTQ_REDIS_URL=redis://127.0.0.1:6379/0

# 64+ chars random. openssl rand -hex 48
HOSTQ_JWT_SECRET=change-me-in-production-please

# Where vhosts get written
HOSTQ_NGINX_SITES=/etc/nginx/sites-available
HOSTQ_APACHE_SITES=/etc/apache2/sites-available
HOSTQ_WEB_ROOT=/var/www

# Allowed frontend origin for CORS (production: panel.your.tld)
HOSTQ_FRONTEND_ORIGIN=http://localhost:3000
