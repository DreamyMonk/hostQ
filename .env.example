# hostQ Go environment

HOSTQ_DATA_DIR=/etc/hostq
HOSTQ_GO_ADDR=127.0.0.1:8091
WEB_ROOT=/var/www
HOSTQ_NGINX_AVAILABLE=/etc/nginx/sites-available

# Generate a long random value before production exposure.
JWT_SECRET=change_this_hostq_go_secret

# Public setup port used by setup.sh and Nginx.
PANEL_PUBLIC_PORT=8090

# Direct-IP setup mode. Set to false after a domain and HTTPS are working.
HOSTQ_ALLOW_INSECURE_HTTP=true
