# Hosting Control Panel - Environment Variables
# Copy this file to .env.local and fill in your values

# hostQ first-run account storage
HOSTQ_DATA_DIR=/etc/hostq

# Optional legacy env login fallback. Leave disabled for first-run account setup.
# PANEL_USERNAME=admin
# PANEL_PASSWORD=your_secure_password_here

# JWT Secret (generate a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Expiry
JWT_EXPIRY=24h
SESSION_IDLE_TIMEOUT_MINUTES=30

# When true, privileged direct shell commands are rejected unless implemented in hostq-helper.
# Enable after installing the helper allowlist with setup.sh.
HOSTQ_REQUIRE_HELPER=false
HOSTQ_HELPER=/usr/local/sbin/hostq-helper

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_USER=root
DB_ROOT_PASSWORD=your_mysql_root_password

# phpMyAdmin URL (full URL where phpMyAdmin is accessible)
PHPMYADMIN_URL=http://localhost/phpmyadmin

# File Manager Root Directory (restrict to this path on server)
FILE_MANAGER_ROOT=/var/www

# Server Web Root
WEB_ROOT=/var/www/html

# Panel URL (used for SSL linkbacks)
PANEL_DOMAIN=panel.yourdomain.com
PANEL_URL=https://panel.yourdomain.com

# Public HTTP port for direct IP access during setup.
# Nginx listens here and proxies to the private Next.js process.
PANEL_PUBLIC_PORT=8090

# Temporary direct-IP setup mode. Keep true only until a domain and HTTPS work,
# then set false so production API routes require HTTPS.
HOSTQ_ALLOW_INSECURE_HTTP=true

# Runtime tuning for 1GB RAM VPS deployments
NODE_OPTIONS=--max-old-space-size=384
